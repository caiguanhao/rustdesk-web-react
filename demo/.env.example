# Copy this file to demo/.env.local and fill it in locally.
# demo/.env.local is gitignored and must never be committed: it may contain a
# remote-device password. This template intentionally contains no secrets.
#
# Vite exposes VITE_* values to the browser, so anything here is visible to
# anyone using the demo page. Only the local demo should read them.

# hbbs host (or host:port). On an HTTPS page without a port this becomes
# wss://<host>/ws/id; with a port the WS port is shifted by +2.
VITE_RD_SERVER=

# hbbs Ed25519 public key (base64), required for self-hosted servers.
VITE_RD_KEY=

# Optional relay override; usually leave empty to use RelayResponse / hbbs +3.
VITE_RD_RELAY=

# Remote device ID.
VITE_RD_ID=

# Optional local convenience. The demo prefills this field but never writes it
# to localStorage or logs. Ignored and rejected in static builds.
# Leave empty to use the viewer's password prompt.
VITE_RD_PASSWORD=

# Credential mode: `password` (default) or `hash` (passwordHash +
# serverKeyVerifier). Env values are only first-run defaults. Ignored in
# static builds (password only).
VITE_RD_CREDENTIAL_MODE=

# Hash mode: the peer's Hash.salt (UTF-8 string). The demo API uses it with the
# password to compute h1 = base64(SHA256(password || salt)). This is not secret,
# but it must match the controlled device or the h1 will be rejected.
# Copy `salt = "..."` from the controlled device's RustDesk.toml:
#   macOS: ~/Library/Preferences/com.carriez.RustDesk/RustDesk.toml
#   Linux: ~/.config/rustdesk/RustDesk.toml
VITE_RD_SALT=

# Same-origin decoder assets. `npm run dev` copies assets/ogv/ to
# demo/public/rustdesk-assets/ (gitignored). Static builds derive this from
# VITE_RD_BASE and ignore this value.
VITE_RD_ASSET_BASE=/rustdesk-assets/

# Static GitHub Pages build only. The Pages workflow sets these in the build
# environment; static mode hides hash credentials and reads/writes no
# localStorage or sessionStorage.
# VITE_RD_STATIC_DEMO=1
# VITE_RD_BASE=/rustdesk-web-react/
