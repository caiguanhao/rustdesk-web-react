{
  "name": "rustdesk-web-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React + TypeScript library embedding RustDesk remote viewing/control into an existing React admin.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "fast-sha256": "1.3.0",
    "libsodium-wrappers": "0.8.4",
    "wasm-feature-detect": "1.10.1",
    "yuv-canvas": "1.2.6",
    "zstddec": "0.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  }
}
