{
  "name": "rustdesk-web-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React + TypeScript library embedding RustDesk remote viewing/control into an existing React admin.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "src",
    "proto",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "tsconfig.json",
    "tsconfig.build.json",
    "vite.config.ts",
    "scripts/copy-notices.mjs",
    "scripts/check-size.mjs",
    "scripts/check-js-size.mjs",
    "scripts/lib",
    "demo/README.md",
    "demo/.env.example"
  ],
  "bin": {
    "rustdesk-react": "./bin/rustdesk-react.mjs"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "predev": "npm run copy-assets",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prebuild": "npm run check-size",
    "postbuild": "node scripts/copy-notices.mjs",
    "prepack": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "bash scripts/test-real-server.sh",
    "test:decoder": "node scripts/check-decoders.mjs",
    "test:canvas": "playwright test",
    "dev:server": "bash scripts/dev-server.sh",
    "dev:peer": "tsx scripts/controlled-peer.ts",
    "log-server": "node scripts/event-log-server.mjs",
    "copy-assets": "node bin/rustdesk-react.mjs copy-assets demo/public",
    "check-size": "node scripts/check-size.mjs && node scripts/check-js-size.mjs",
    "check-js-size": "node scripts/check-js-size.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "fast-sha256": "1.3.0",
    "libsodium-wrappers": "0.8.4",
    "long": "5.3.2",
    "protobufjs": "8.8.1",
    "wasm-feature-detect": "1.10.1",
    "yuv-canvas": "1.2.6",
    "zstddec": "0.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  }
}
