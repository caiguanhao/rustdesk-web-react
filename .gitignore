

# General logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# 私密配置（用户本机创建，可能含密码，绝不提交）
# Vite 读取整个 .env* 家族，所以全部忽略；只放行将来用于展示的模板。
demo/.env*
!demo/.env.example

# Node modules and build output
node_modules/
dist/
coverage/

# Python cache (if using Python projects)
__pycache__/
*.pyc

# Rust build (if using Rust projects)
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# 本机 Claude 配置（可含机器相关的绝对路径）
.claude/settings.local.json

